<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbShell</AssemblyName>
    <RootNamespace>JARVIS.ORB</RootNamespace>
    <!-- PerMonitorV2 DPI awareness is set in Program.cs via
         Application.SetHighDpiMode (WinForms' supported path). -->
    <!-- Native AOT would need WebView2 ref assemblies; framework-dependent is the
         lightweight choice for a machine that already has the .NET 8 runtime. -->
    <!-- MSB3277: the WebView2 package ships a Wpf assembly whose WindowsBase
         reference is unified against the WindowsDesktop pack. Benign; silence
         the version-unification warning at project level. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
